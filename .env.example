# Copy to .env for local development. Never commit .env.
# The application ships with no defaults that reach the network.

# Path to the mpv binary. Empty -> looked up on PATH.
EON_MPV_PATH=

# Local streaming server port. 0 -> random free port (the default; prefer it).
EON_STREAM_PORT=0

# Verbose logging. Logs stay on the device; nothing is uploaded (madde 36).
EON_LOG=info

 edu| edu
EON_PROFILE=stream
